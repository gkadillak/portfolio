---
import { getCollection } from "astro:content";
import ArrowLink from "../../components/ArrowLink.astro";
import { accentVars } from "../../data/site";
import Base from "../../layouts/Base.astro";

const writing = (await getCollection("writing")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const years = [
  ...new Set(writing.map((w) => w.data.pubDate.getFullYear())),
].sort();
---
<Base title="Essays & notes — Garrett Kadillak" active="writing" description="I write to find out what I think.">
  <section class="hero wrap">
    <span class="mono" style="color:var(--primary);display:block;margin-bottom:24px">Writing · {writing.length} pieces</span>
    <h1 class="display">Essays<br />&amp; notes</h1>
    <p class="sub">I write to find out what I think. Some of these are finished thoughts; most are works in progress.</p>
  </section>

  <section class="wrap">
    <div class="section-head">
      <span class="mono mono-ink mono-13">Index — most recent first</span>
      <span class="mono mono-13">{years[0]} / {years.at(-1)}</span>
    </div>
    {writing.map((w) => (
      <a href={`/writing/${w.id}`} class="row note-row" style={accentVars(w.data.accent)}>
        <div class="row-n">{w.data.n}</div>
        <div>
          <span class="mono mono-dim kick"><span class="mono-a">{w.data.kicker}</span> · {w.data.read} read · {w.data.date}</span>
          <h3 class="row-title">{w.data.title}</h3>
          <p class="dek">{w.data.dek}</p>
        </div>
        <span class="go"><ArrowLink color="var(--a)" size="14px">Read</ArrowLink></span>
      </a>
    ))}
    <div class="end"><span class="mono mono-dim">That's everything for now. More soon.</span></div>
  </section>
</Base>
<style>
.hero{padding-block:72px 40px}
h1{font-size:clamp(3rem,1rem + 8vw,8rem);line-height:.85;margin-left:-.05em}
.sub{font-family:var(--font-serif);font-size:var(--t-lead);line-height:1.5;color:var(--fg2);max-width:46ch;margin:30px 0 0}
.note-row{grid-template-columns:112px 1fr 200px;align-items:start;padding-block:34px}
.row-n{font-size:56px}
.kick{display:block;margin-bottom:12px}
.mono-a{font-weight:600}
.row-title{font-weight:700;font-size:34px;line-height:1.05;letter-spacing:-.025em;margin-bottom:10px}
.dek{font-family:var(--font-serif);font-size:18px;line-height:1.5;color:var(--fg2);margin:0;max-width:58ch}
.go{display:flex;justify-content:flex-end;align-items:center}
.end{padding:40px 0 64px}
@media (max-width:820px){
  .note-row{grid-template-columns:64px 1fr;gap:20px}
  .row-n{font-size:40px}
  .row-title{font-size:26px}
  .go{display:none}
}
</style>
