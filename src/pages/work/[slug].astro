---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ArrowLink from "../../components/ArrowLink.astro";
import Cover from "../../components/Cover.astro";
import StatusChip from "../../components/StatusChip.astro";
import { accents, accentVars } from "../../data/site";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) =>
    b.data.n.localeCompare(a.data.n),
  );
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

type Entry = CollectionEntry<"work">;
const { entry, next } = Astro.props as { entry: Entry; next: Entry };
const p = entry.data;
const { Content } = await render(entry);
const meta = [
  { k: "Role", v: p.role },
  { k: "Timeline", v: p.timeline },
  { k: "Stack", v: p.stack.join(", ") },
];
---
<Base title={`${p.title} — Garrett Kadillak`} description={p.tagline} active="work">
  <div style={accentVars(p.accent)}>
    <div class="band"></div>

    <section class="wrap top">
      <ArrowLink href="/" color="var(--fg2)" reverse>All work</ArrowLink>
      <div class="head">
        <div>
          <div class="kick">
            <span class="mono mono-a mono-13">Project {p.n}</span><span class="dot"></span>
            <span class="mono mono-dim mono-13">{p.category}</span><span class="dot"></span>
            <StatusChip label={p.status} />
          </div>
          <h1 class="display">{p.title}</h1>
          <p class="tagline">{p.tagline}</p>
        </div>
        <div class="bignum">{p.n}</div>
      </div>
    </section>

    <section class="wrap">
      <div class="metastrip">
        {meta.map((m) => (
          <div class="cell">
            <span class="mono mono-dim label">{m.k}</span>
            <span class="val">{m.v}</span>
          </div>
        ))}
        <div class="cell">
          <span class="mono mono-dim label">Links</span>
          <div class="links">
            {p.links.map((l) => <ArrowLink href={l.href} color="var(--a)">{l.label}</ArrowLink>)}
          </div>
        </div>
      </div>
    </section>

    <section class="wrap covershot">
      <Cover accent={p.accent} title={p.title} n={p.n} src={p.cover} height={520} showNumber />
      {p.gallery[0] && <span class="mono mono-dim cap">{p.gallery[0].label}</span>}
    </section>

    <section class="wrap">
      <div class="prose prose--lead">
        <p>{p.summary}</p>
        <Content />
      </div>
    </section>

    {p.stats.length > 0 && (
      <section class="wrap">
        <div class="stats">
          {p.stats.map((s) => (
            <div>
              <div class="statnum">{s.value}</div>
              <span class="mono label">{s.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {p.gallery.length > 0 && (
      <section class="wrap gallery">
        <span class="mono mono-ink mono-13 label">Selected screens</span>
        <div class="grid">
          {p.gallery.map((g, i) => (
            <div>
              <Cover accent={p.accent} title={p.title} src={g.src} height={220} sizes="(max-width:820px) 100vw, 33vw" />
              <span class="mono mono-dim label">{i + 1} / {g.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="wrap nextsec">
      <a href={`/work/${next.id}`} class="next" style={`--next-a:${accents[next.data.accent].solid}`}>
        <div class="nextnum">{next.data.n}</div>
        <div class="grow">
          <span class="mono mono-dim label">Next project</span>
          <span class="nexttitle">{next.data.title}</span>
        </div>
        <span class="g">→</span>
      </a>
    </section>
  </div>
</Base>
<style>
.band{height:6px;background:var(--a)}
.top{padding-top:40px}
.head{display:grid;grid-template-columns:1fr 320px;gap:56px;align-items:end;margin-top:40px;padding-bottom:40px;border-bottom:2px solid var(--fg1)}
.kick{display:flex;align-items:center;gap:14px;margin-bottom:20px;flex-wrap:wrap}
h1{font-size:clamp(3rem,1.5rem + 5vw,6rem);line-height:.86;letter-spacing:-.04em}
.tagline{font-family:var(--font-serif);font-size:var(--t-lead);line-height:1.45;color:var(--fg2);max-width:44ch;margin:22px 0 0}
.bignum{font-family:var(--font-display);font-weight:800;font-size:132px;line-height:.75;color:var(--a);letter-spacing:-.05em;text-align:right}
.metastrip{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--border)}
.cell{padding:26px 28px 26px 0;border-right:1px solid var(--border)}
.cell + .cell{padding-left:28px}
.cell:last-child{border-right:0}
.label{display:block;margin-bottom:10px}
.val{font-size:15px;color:var(--fg1);line-height:1.45}
.links{display:flex;flex-wrap:wrap;gap:6px 16px}
.covershot{padding-top:48px}
.cap{display:block;margin-top:14px}
.prose{padding-top:56px}
.stats{max-width:var(--measure);margin:24px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:28px;border-top:2px solid var(--fg1);border-bottom:1px solid var(--border);padding:32px 0}
.statnum{font-family:var(--font-display);font-weight:800;font-size:44px;letter-spacing:-.03em;color:var(--a)}
.stats .label{margin:8px 0 0;color:var(--fg2)}
.gallery{padding-top:48px}
.gallery .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px}
.gallery .grid .label{margin:12px 0 0}
.nextsec{padding:64px 0 80px}
.next{display:flex;align-items:center;gap:24px;padding:30px var(--pad);border-top:1px solid var(--border);border-bottom:1px solid var(--border);text-decoration:none}
.nextnum{font-family:var(--font-display);font-weight:800;font-size:56px;line-height:.8;color:var(--next-a);letter-spacing:-.04em}
.grow{flex:1}
.nexttitle{font-family:var(--font-display);font-weight:700;font-size:32px;letter-spacing:-.025em;color:var(--fg1);transition:color var(--dur) var(--ease-out)}
.next:hover .nexttitle{color:var(--primary)}
.next .g{font-size:28px;color:var(--fg2);display:inline-block;transition:transform var(--dur) var(--ease-out)}
.next:hover .g{transform:translateX(4px)}
@media (max-width:900px){
  .head{grid-template-columns:1fr;gap:24px}
  .bignum{display:none}
  .metastrip{grid-template-columns:1fr 1fr}
  .cell:nth-child(2n){border-right:0}
  .gallery .grid{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr;gap:20px}
}
</style>
